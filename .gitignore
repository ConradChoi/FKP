# dependencies
/node_modules

# next.js
/.next/
/out/

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem

# env
.env*.local

# logs
npm-debug.log*

# playwright
/test-results/
/playwright-report/
